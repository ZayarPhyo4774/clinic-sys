# Copy to .env and replace every placeholder. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO

POSTGRES_DB=clinicsys
POSTGRES_USER=clinicsys
POSTGRES_PASSWORD=change-me
# Host-side tools use localhost. Docker Compose overrides this to the postgres service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host-side tools use localhost. Docker Compose overrides this to the redis service.
REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000
