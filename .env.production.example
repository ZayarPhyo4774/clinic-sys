# Copy to .env for production. Replace every placeholder. Never commit .env.

DJANGO_SECRET_KEY=replace-with-at-least-32-random-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=clinic.example.com,backend
DJANGO_SECURE_SSL_REDIRECT=False
LOG_LEVEL=INFO

POSTGRES_DB=clinicsys
POSTGRES_USER=clinicsys
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@localhost:6379/0

# Used by host-side tools only. Compose overrides service hostnames.
CORS_ALLOWED_ORIGINS=https://clinic.example.com
